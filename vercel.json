{
  "redirects": [
    { "source": "/diagnostico", "destination": "/#diagnostico", "permanent": true },
    { "source": "/diagnostico/", "destination": "/#diagnostico", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|webp|woff2|jpg|jpeg|png|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
